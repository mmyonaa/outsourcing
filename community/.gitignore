# 인증서 관련
*.pem
*.key
*.crt
*.cert

# Dependencies
node_modules

# Build output
dist

# npm lockfile (이 프로젝트는 pnpm 사용 — pnpm-lock.yaml은 커밋함)
package-lock.json

# OS files
.DS_Store

# IDE
.vscode/*
.idea

# Environment variables
.env
.env.local
.env.*.local

# 문서 디렉토리 전체는 로컬 참고용으로만 관리 (이제부터 커밋 금지)
docs/

# XML (sitemap.xml은 빌드 시 generate-sitemap.mjs가 자동 생성하는 산출물이라 추적하지 않음)
*.xml
# robots.txt는 정적 파일이므로 유지 (xml 아님 — 규칙 정리용 주석)

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
.cache

# Upload files (if stored locally)
uploads/
public/uploads/