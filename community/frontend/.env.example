# 프론트엔드 환경변수 (Vite). VITE_ 접두사만 클라이언트에 노출됨.
# 카카오맵 JavaScript 키 (Kakao Developers에서 발급, 사이트 도메인 제한 권장)
VITE_KAKAO_MAP_KEY=your_kakao_javascript_key

# API 서버 주소 (미지정 시 운영 https://bktheater.com/api 사용)
# 로컬 백엔드로 개발할 때: VITE_API_SERVER=http://localhost:3000/api
